# Keep dependencies generated by pi local to ~/.pi/agent.  Stowing them can
# overwrite or remove the installation used by local extensions.
node_modules
package-lock\.json
pnpm-lock\.yaml

# GNU Stow's built-in defaults are replaced when a local ignore file exists.
RCS
.+,v
CVS
\.\#.+
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
.+~
\#.*\#
^/README.*
^/LICENSE.*
^/COPYING

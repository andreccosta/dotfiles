
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "lsp": false,
  "formatter": false,
  "snapshot": false,
  "mcp": {
    "linear": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "sentry": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "grafana": {
      "enabled": false,
      "type": "remote",
      "url": "https://grafana-mcp.gke00.usce1.mgmt.internal.amplemarket.com/mcp"
    },
    "pganalyze": {
      "enabled": false,
      "type": "remote",
      "url": "https://pganalyze-mcp.gke00.usce1.mgmt.internal.amplemarket.com/mcp"
    }
  },
  "provider": {
    "work": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "{env:CODEX_LB_URL}",
        "apiKey": "{env:CODEX_LB_API_KEY}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "disabled": true
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "options": {
            "serviceTier": "priority"
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "options": {
            "serviceTier": "priority"
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          },
          "options": {
            "serviceTier": "priority"
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          },
          "options": {
            "serviceTier": "priority"
          }
        }
      }
    }
  },
  "plugin": [],
  "permission": {
    "bash": {
      "rm *": "ask"
    },
    "read": {
      "*": "allow",
      ".*.vars": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "secrets/*": "deny"
    },
    "todoread": "allow",
    "todowrite": "allow"
  }
}

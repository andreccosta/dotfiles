{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "formatter": false,
  "snapshots": false,
  "mcp": {
    "servers": {
      "planwright": {
        "disabled": false,
        "type": "remote",
        "url": "https://planwright.acklabs.dev/mcp"
      },
      "linear": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "sentry": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "grafana": {
        "disabled": true,
        "type": "remote",
        "url": "https://grafana-mcp.gke00.usce1.mgmt.internal.amplemarket.com/mcp"
      },
      "pganalyze": {
        "disabled": true,
        "type": "remote",
        "url": "https://app.pganalyze.com/mcp"
      },
      "metabase": {
        "disabled": true,
        "type": "remote",
        "url": "https://metabase-engineering.gke00.usce1.prod.internal.amplemarket.com/api/metabase-mcp"
      }
    }
  },
  "providers": {
    "work": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "{env:CODEX_LB_URL}",
        "apiKey": "{env:CODEX_LB_API_KEY}"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ],
          "settings": {
            "serviceTier": "priority"
          }
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ],
          "settings": {
            "serviceTier": "priority"
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ],
          "settings": {
            "serviceTier": "priority"
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ],
          "settings": {
            "serviceTier": "priority"
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ],
          "settings": {
            "serviceTier": "priority"
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "auto",
                "include": [
                  "reasoning.encrypted_content"
                ]
              }
            }
          ],
          "settings": {
            "serviceTier": "priority"
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": [
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "auto",
                "include": [
                  "reasoning.encrypted_content"
                ]
              }
            }
          ],
          "settings": {
            "serviceTier": "priority"
          }
        }
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": ".*.vars", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.envrc", "effect": "deny" },
    { "action": "read", "resource": "secrets/*", "effect": "deny" }
  ]
}

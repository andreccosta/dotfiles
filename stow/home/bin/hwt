#!/usr/bin/env bash
set -euo pipefail

HERDR_BIN="${HERDR_BIN_PATH:-herdr}"

usage() {
  cat <<'EOF'
Usage: hwt <command> [args]

Commands:
  create <branch> [base]   Create a Worktrunk worktree and open it in Herdr
  switch [branch-or-path]  Switch/select a Worktrunk worktree and open it in Herdr
  open [branch-or-path]    Alias for switch
  review <pr|branch|path>  Open a review worktree (--no-hooks) under
                           .worktrees/reviews/; a bare number means pr:<n>
  remove [branch-or-path]  Remove a worktree and return Herdr to the primary checkout
                           Review paths use --no-hooks --force-delete

Examples:
  hwt create feature/foo
  hwt create hotfix release/1.2
  hwt switch               # uses Worktrunk's picker
  hwt switch feature/foo
  hwt open feature/foo     # same as switch
  hwt review 123           # review GitHub PR 123 in an isolated worktree
  hwt review feature/foo   # review an existing branch
  hwt remove               # detects review worktrees automatically
EOF
}

fail() {
  printf 'hwt: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}
ensure_herdr_server() {
  if [[ "${HERDR_ENV:-0}" == "1" ]] || "$HERDR_BIN" status server >/dev/null 2>&1; then
    return
  fi

  nohup "$HERDR_BIN" server >/dev/null 2>&1 &
  for _ in {1..50}; do
    "$HERDR_BIN" status server >/dev/null 2>&1 && return
    sleep 0.1
  done

  fail "failed to start the Herdr server"
}

attach_herdr_if_needed() {
  if [[ "${HERDR_ENV:-0}" != "1" ]]; then
    exec "$HERDR_BIN"
  fi
}


checkout_root() {
  git -C "${1:-$PWD}" rev-parse --path-format=absolute --show-toplevel 2>/dev/null \
    || fail "not inside a git repository"
}

source_root() {
  local root common primary
  root="$(checkout_root "${1:-$PWD}")"

  # If invoked from a linked worktree, Herdr needs the source checkout as --cwd
  # so it can attach the opened checkout to the existing worktree group.
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ -n "$common" ]]; then
    primary="$(dirname "$common")"
    if git -C "$primary" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      checkout_root "$primary"
      return
    fi
  fi

  printf '%s\n' "$root"
}

json_field() {
  python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for name in sys.argv[1:]:
    value = data.get(name)
    if value:
        print(value)
        sys.exit(0)
# Worktrunk schema variants used by older/newer versions.
worktree = data.get("worktree")
if isinstance(worktree, dict):
    for name in ("path", "worktree_path", "checkout_path"):
        value = worktree.get(name)
        if value:
            print(value)
            sys.exit(0)
sys.exit(1)
' "$@"
}

worktrunk_path() {
  json_field path worktree_path checkout_path
}

open_in_herdr() {
  local source="$1" path="$2"
  [[ -n "$path" ]] || fail "empty worktree path"
  ensure_herdr_server
  "$HERDR_BIN" worktree open --cwd "$source" --path "$path" --focus >/dev/null
  attach_herdr_if_needed
}

cmd_create() {
  local branch="${1:-}" base="${2:-}" cwd source out path
  [[ -n "$branch" ]] || fail "create requires a branch name"
  [[ $# -le 2 ]] || fail "create accepts at most: <branch> [base]"

  cwd="$(checkout_root)"
  source="$(source_root "$cwd")"

  if [[ -n "$base" ]]; then
    out="$(wt -C "$cwd" switch --create "$branch" --base "$base" --no-cd --format=json)"
  else
    out="$(wt -C "$cwd" switch --create "$branch" --no-cd --format=json)"
  fi
  path="$(printf '%s' "$out" | worktrunk_path)" || fail "Worktrunk did not return a worktree path"
  open_in_herdr "$source" "$path"
}

open_worktree() {
  local cwd="$1" target="$2"; shift 2
  local extra=("$@") source out path
  source="$(source_root "$cwd")"

  if [[ -n "$target" ]]; then
    out="$(wt -C "$cwd" switch ${extra[@]+"${extra[@]}"} "$target" --no-cd --format=json)"
  else
    out="$(wt -C "$cwd" switch ${extra[@]+"${extra[@]}"} --no-cd --format=json)"
  fi
  path="$(printf '%s' "$out" | worktrunk_path)" || fail "Worktrunk did not return a worktree path"
  open_in_herdr "$source" "$path"
}

cmd_open() {
  local target="${1:-}" cwd
  [[ $# -le 1 ]] || fail "open accepts at most: [branch-or-path]"
  cwd="$(checkout_root)"
  open_worktree "$cwd" "$target"
}

expand_pr_target() {
  local target="$1"
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    printf 'pr:%s\n' "$target"
  else
    printf '%s\n' "$target"
  fi
}

is_review_path() {
  case "$1" in
    */.worktrees/reviews/*) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_worktree_path() {
  local root="$1" target="$2"
  if [[ -z "$target" ]]; then
    checkout_root "$root"
    return
  fi
  wt -C "$root" list --format=json | python3 -c '
import json, os, sys
target = sys.argv[1]
data = json.load(sys.stdin)
for item in data.get("items", []):
    wt = item.get("worktree") or {}
    path = wt.get("path")
    if not path:
        continue
    if item.get("branch") == target or path == target \
            or os.path.abspath(path) == os.path.abspath(target):
        print(path)
        sys.exit(0)
sys.exit(1)
' "$target"
}

cmd_review() {
  local target="${1:-}" cwd
  [[ -n "$target" ]] || fail "review requires a pr-number, branch, or path"
  [[ $# -le 1 ]] || fail "review accepts at most: [pr-number|branch-or-path]"
  cwd="$(checkout_root)"
  open_worktree "$cwd" "$(expand_pr_target "$target")" \
    --no-hooks \
    --config-set "worktree-path='{{ repo_path }}/.worktrees/reviews/{{ branch | sanitize }}'"
}

cmd_remove() {
  local target="${1:-}" cwd source removed_root
  [[ $# -le 1 ]] || fail "remove accepts at most: [branch-or-path]"

  cwd="$(checkout_root)"
  source="$(source_root "$cwd")"
  removed_root="$(resolve_worktree_path "$cwd" "$target" 2>/dev/null || true)"
  local extra=(--foreground)
  if [[ -n "$removed_root" ]] && is_review_path "$removed_root"; then
    extra+=(--no-hooks --force-delete)
  fi

  if [[ -n "$target" ]]; then
    wt -C "$cwd" remove "${extra[@]}" "$target"
  else
    wt -C "$cwd" remove "${extra[@]}"
  fi

  # If this runs inside Herdr, return to the primary/source checkout. Close the
  # removed workspace only when Herdr told us which workspace invoked the command.
  ensure_herdr_server
  "$HERDR_BIN" worktree open --cwd "$source" --path "$source" --focus || true
  if [[ -n "${HERDR_WORKSPACE_ID:-}" && "$removed_root" == "$cwd" && "$removed_root" != "$source" ]]; then
    "$HERDR_BIN" workspace close "$HERDR_WORKSPACE_ID" || true
  fi
  attach_herdr_if_needed
}

main() {
  need git
  need wt
  need python3
  need "$HERDR_BIN"

  case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    open|switch) shift; cmd_open "$@" ;;
    review) shift; cmd_review "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    -h|--help|help|"") usage ;;
    *) fail "unknown command: $1" ;;
  esac
}

main "$@"

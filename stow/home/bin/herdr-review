#!/usr/bin/env bash
# Have another coding agent review the current changes in a new Herdr tab and
# print only its findings; follow up with the same reviewer over several rounds.
# See `herdr-review --help`.
set -euo pipefail

HERDR_BIN="${HERDR_BIN_PATH:-herdr}"
STATE_ROOT="${HERDR_REVIEW_DIR:-${TMPDIR:-/tmp}/herdr-review}"
DEFAULT_TIMEOUT=540

usage() {
  cat <<'EOF'
Usage:
  herdr-review [options] [-- <agent-args...>]        Start a reviewer; print its findings (round 1)
  herdr-review reply <name> [--file F] [--timeout S]  Send your response to the findings (or stdin)
                                                      and print the reviewer's follow-up (next round)
  herdr-review wait <name> [--timeout SECS]           Keep waiting for the current round
  herdr-review cleanup <name>                         Close the reviewer's tab and remove its files

Starts a different coding agent in a new tab of the current Herdr workspace,
asks it to review the diff between the default branch (merge base) and the
current working tree (including uncommitted and untracked changes), waits for
it, and prints only its findings (Markdown) on stdout. Findings are numbered
(F1, F2, ...) and end with a `VERDICT: approved` or `VERDICT: changes-requested`
line.

`reply` sends the implementer's response (which findings were fixed and how,
which were discarded and why) to the same reviewer. It re-reviews the current
changes and reports what is resolved, what is not, whether it accepts each
discard, and any new findings, with a new verdict. The reviewer's tab stays
open between rounds.

Options:
  -a, --agent KIND     Reviewer harness: claude, codex, pi, opencode, ...
                       Default: a different harness than the caller
                       (codex when called from claude, otherwise claude).
  -m, --model MODEL    Reviewer model, passed to the harness as --model.
  -b, --base REF       Compare against REF instead of the default branch.
  -f, --focus TEXT     Extra review instructions.
  -t, --timeout SECS   How long to wait for findings (default: 540).
  -h, --help           Show this help.
  -- <agent-args...>   Extra arguments for the reviewer harness.

Exit codes:
  0  findings printed
  1  error
  2  usage error
  3  reviewer is blocked on an approval or question; answer it in its tab,
     then run `herdr-review wait <name>`
  4  timed out while the reviewer is still working; run `herdr-review wait <name>`
  5  reviewer finished without writing findings; inspect its tab

Examples:
  herdr-review
  herdr-review --agent codex
  herdr-review --agent claude --model opus --focus "error handling and tests"
  herdr-review --base origin/release-1.2
  printf '%s\n' '- F1 fixed: ...' | herdr-review reply review-1a2b3c
  herdr-review reply review-1a2b3c --file response.md
  herdr-review wait review-1a2b3c
  herdr-review cleanup review-1a2b3c
EOF
}

fail() {
  printf 'herdr-review: %s\n' "$*" >&2
  exit 1
}

usage_error() {
  printf 'herdr-review: %s\n' "$*" >&2
  printf "Run 'herdr-review --help' for usage.\n" >&2
  exit 2
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

# Prints the value at a dotted path of the JSON document on stdin; fails when absent.
json_get() {
  python3 -c '
import json, sys
data = json.load(sys.stdin)
for key in sys.argv[1].split("."):
    data = data.get(key) if isinstance(data, dict) else None
    if data is None:
        sys.exit(1)
print(data)
' "$1"
}

positive_int() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]] || usage_error "--timeout must be a positive number of seconds"
}

require_herdr() {
  [[ "${HERDR_ENV:-}" == 1 ]] || fail "must run inside a Herdr pane (HERDR_ENV=1)"
}

caller_kind() {
  [[ -n "${HERDR_PANE_ID:-}" ]] || return 0
  "$HERDR_BIN" agent get "$HERDR_PANE_ID" 2>/dev/null | json_get result.agent.agent 2>/dev/null || true
}

default_branch() {
  local root="$1" ref branch
  if ref="$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD)"; then
    printf '%s\n' "$ref"
    return
  fi
  for branch in main master; do
    if git -C "$root" show-ref --verify -q "refs/heads/$branch"; then
      printf '%s\n' "$branch"
      return
    fi
  done
  fail "cannot determine the default branch; pass --base"
}

agent_status() {
  "$HERDR_BIN" agent get "$1" 2>/dev/null | json_get result.agent.agent_status 2>/dev/null || printf 'gone\n'
}

review_dir() {
  local name="$1" dir
  [[ "$name" =~ ^review-[0-9a-f]{6}$ ]] || usage_error "invalid reviewer name: $name"
  dir="$STATE_ROOT/$name"
  [[ -d "$dir" ]] || fail "unknown reviewer: $name"
  printf '%s\n' "$dir"
}

state_read() {
  [[ -f "$1/$2" ]] && cat "$1/$2"
}

current_round() {
  state_read "$1" round || printf '1\n'
}

# Sends the current round's prompt once and waits for the reviewer to settle.
prompt_reviewer() {
  local name="$1" dir="$2" timeout="$3" round err
  round="$(current_round "$dir")"
  if "$HERDR_BIN" agent prompt "$name" "$(cat "$dir/prompt-$round.md")" --wait --timeout "$((timeout * 1000))" \
    >/dev/null 2>"$dir/herdr.err"; then
    touch "$dir/prompted-$round"
    return
  fi
  err="$(cat "$dir/herdr.err")"
  # These are rejected before any input is sent; anything else means the prompt went through.
  if [[ "$err" != *agent_blocked* && "$err" != *not_found* ]]; then
    touch "$dir/prompted-$round"
  fi
}

wait_reviewer() {
  local name="$1" dir="$2" timeout="$3"
  "$HERDR_BIN" agent wait "$name" --timeout "$((timeout * 1000))" >/dev/null 2>"$dir/herdr.err" || true
}

# Prints the current round's findings, or explains why there are none, and exits with the documented code.
finish() {
  local name="$1" dir="$2" status tab round findings
  status="$(agent_status "$name")"
  tab="$(state_read "$dir" tab_id || true)"
  round="$(current_round "$dir")"
  findings="$dir/findings-$round.md"
  case "$status" in
    blocked)
      printf 'herdr-review: %s (tab %s) is blocked on an approval or question.\n' "$name" "$tab" >&2
      printf 'Answer it in that tab, then run: herdr-review wait %s\n' "$name" >&2
      exit 3
      ;;
    working | unknown)
      printf 'herdr-review: %s (tab %s) is still working on round %s.\n' "$name" "$tab" "$round" >&2
      printf 'Keep waiting with: herdr-review wait %s\n' "$name" >&2
      exit 4
      ;;
  esac
  if [[ ! -f "$dir/prompted-$round" ]]; then
    printf 'herdr-review: %s (tab %s) never received the round %s prompt (status: %s).\n' \
      "$name" "$tab" "$round" "$status" >&2
    [[ -s "$dir/herdr.err" ]] && cat "$dir/herdr.err" >&2
    printf 'Once it is ready, run: herdr-review wait %s\n' "$name" >&2
    exit 3
  fi
  if [[ -s "$findings" ]]; then
    cat "$findings"
    printf '\nherdr-review: round %s from %s (tab %s). Respond on stdin with: herdr-review reply %s\n' \
      "$round" "$name" "$tab" "$name" >&2
    printf 'herdr-review: close it with: herdr-review cleanup %s\n' "$name" >&2
    exit 0
  fi
  printf 'herdr-review: %s (tab %s, status: %s) finished round %s without writing %s.\n' \
    "$name" "$tab" "$status" "$round" "$findings" >&2
  [[ -s "$dir/herdr.err" ]] && cat "$dir/herdr.err" >&2
  printf 'Inspect it with: herdr agent read %s --source recent-unwrapped --lines 120\n' "$name" >&2
  exit 5
}

# Instructions shared by every round.
review_scope() {
  local cwd="$1" base="$2" merge_base="$3"
  printf '%s' "Review the changes in $cwd between $base and the current working tree: inspect them with \`git diff $merge_base\` plus any untracked files listed by \`git status --short\`. Read surrounding code as needed and run read-only checks (tests, linters) if useful. Do not modify, stage, or commit any repository files."
}

build_prompt() {
  local cwd="$1" base="$2" merge_base="$3" findings="$4" focus="$5"
  printf '%s' "You are reviewing code changes. $(review_scope "$cwd" "$base" "$merge_base")"
  [[ -n "$focus" ]] && printf ' %s' "Additional instructions: $focus"
  printf ' %s' "Report only actionable findings (bugs, regressions, security issues, missing tests or edge cases, clear maintainability problems), ordered by severity. Number them F1, F2, ... and give each a severity (high, medium, low), file:line, the problem, and a concrete fix. Skip style nits and praise; if there are no findings, say so. End with one line: \`VERDICT: approved\` if there are no findings, otherwise \`VERDICT: changes-requested\`. The implementing agent may reply with fixes and discards in later rounds, so keep your findings and their numbers in mind. When done, write your findings as Markdown to $findings (create or overwrite it), then reply only with: Review written to $findings"
}

build_reply_prompt() {
  local cwd="$1" base="$2" merge_base="$3" findings="$4" round="$5" response="$6"
  printf '%s' "Follow-up review, round $round. The implementing agent responded to your previous findings in $response: read it first. Then $(review_scope "$cwd" "$base" "$merge_base") Write Markdown with these sections, omitting empty ones: \"Resolved\" (findings you confirm are fixed), \"Not resolved\" (fixes that are missing, incomplete, or wrong, and why), \"Discarded findings\" (for each finding the implementer declined or deferred: whether you accept the reasoning, and if not, why it still matters), and \"New findings\" (issues you have not reported before, including ones introduced by the fixes, numbered after your previous findings, with severity, file:line, problem, and fix). Refer to findings by their numbers. Do not re-raise findings you already accepted as resolved or discarded. If the implementer gives new reasoning or evidence for a discard you disputed, accept it, or say specifically what is still wrong and what would change your mind instead of repeating your earlier argument. End with one line: \`VERDICT: approved\` if nothing remains that you would block on, otherwise \`VERDICT: changes-requested\`. Write it to $findings (create or overwrite it), then reply only with: Review written to $findings"
}

cmd_start() {
  local agent="" model="" base="" focus="" timeout="$DEFAULT_TIMEOUT"
  local -a extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a | --agent) [[ $# -ge 2 ]] || usage_error "$1 requires a value"; agent="$2"; shift 2 ;;
      -m | --model) [[ $# -ge 2 ]] || usage_error "$1 requires a value"; model="$2"; shift 2 ;;
      -b | --base) [[ $# -ge 2 ]] || usage_error "$1 requires a value"; base="$2"; shift 2 ;;
      -f | --focus) [[ $# -ge 2 ]] || usage_error "$1 requires a value"; focus="$2"; shift 2 ;;
      -t | --timeout) [[ $# -ge 2 ]] || usage_error "$1 requires a value"; positive_int "$2"; timeout="$2"; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      --) shift; extra=("$@"); break ;;
      *) usage_error "unknown option: $1" ;;
    esac
  done

  require_herdr
  local root merge_base caller name dir out tab_id pane_id
  root="$(git rev-parse --path-format=absolute --show-toplevel 2>/dev/null)" || fail "not inside a git repository"
  base="${base:-$(default_branch "$root")}"
  merge_base="$(git -C "$root" merge-base HEAD "$base" 2>/dev/null)" || fail "no merge base between HEAD and $base"

  if [[ -z "$agent" ]]; then
    caller="$(caller_kind)"
    if [[ "$caller" == claude ]]; then agent=codex; else agent=claude; fi
  fi

  mkdir -p "$STATE_ROOT"
  # Physical path, so harness permission rules match after symlink resolution.
  STATE_ROOT="$(cd "$STATE_ROOT" && pwd -P)"
  name="$(printf 'review-%06x' "$(((RANDOM << 15 | RANDOM) & 0xffffff))")"
  dir="$STATE_ROOT/$name"
  mkdir -p "$dir"
  printf '%s\n' "$root" >"$dir/repo"
  printf '%s\n' "$base" >"$dir/base"
  printf '%s\n' "$merge_base" >"$dir/merge_base"
  printf '1\n' >"$dir/round"

  build_prompt "$root" "$base" "$merge_base" "$dir/findings-1.md" "$focus" >"$dir/prompt-1.md"

  out="$("$HERDR_BIN" tab create --workspace "${HERDR_WORKSPACE_ID:?}" --cwd "$root" \
    --label "review: $agent" --no-focus)" || fail "could not create a Herdr tab"
  tab_id="$(printf '%s' "$out" | json_get result.tab.tab_id)" || fail "Herdr did not return a tab id"
  pane_id="$(printf '%s' "$out" | json_get result.root_pane.pane_id)" || fail "Herdr did not return a pane id"
  printf '%s\n' "$tab_id" >"$dir/tab_id"

  local -a args=()
  [[ -n "$model" ]] && args+=(--model "$model")
  case "$agent" in
    # Let the reviewer read responses and write findings in its state directory without approval prompts.
    claude) args+=(--add-dir "$dir" --allowedTools "Write(/$dir/**)") ;;
    # Codex rejects --add-dir under its read-only sandbox (its default outside trusted projects).
    codex) args+=(--sandbox workspace-write --add-dir "$dir") ;;
  esac
  args+=(${extra[@]+"${extra[@]}"})

  printf 'herdr-review: starting %s reviewer %s in tab %s\n' "$agent" "$name" "$tab_id" >&2
  if ! "$HERDR_BIN" agent start "$name" --kind "$agent" --pane "$pane_id" -- ${args[@]+"${args[@]}"} \
    >/dev/null 2>"$dir/herdr.err"; then
    # Startup can stop at a trust or login dialog; give the user a moment to answer it.
    if [[ "$(agent_status "$name")" == gone ]]; then
      cat "$dir/herdr.err" >&2
      fail "could not start $agent in tab $tab_id (run 'herdr-review cleanup $name' to close it)"
    fi
    "$HERDR_BIN" agent wait "$name" --until idle --until "done" --timeout 120000 >/dev/null 2>&1 || true
  fi

  case "$(agent_status "$name")" in
    idle | done) prompt_reviewer "$name" "$dir" "$timeout" ;;
  esac
  finish "$name" "$dir"
}

cmd_reply() {
  local name="" file="" timeout="$DEFAULT_TIMEOUT" dir round next status response
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --file) [[ $# -ge 2 ]] || usage_error "$1 requires a value"; file="$2"; shift 2 ;;
      -t | --timeout) [[ $# -ge 2 ]] || usage_error "$1 requires a value"; positive_int "$2"; timeout="$2"; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      -*) usage_error "unknown option: $1" ;;
      *) [[ -z "$name" ]] || usage_error "unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || usage_error "reply requires a reviewer name"
  require_herdr
  dir="$(review_dir "$name")"
  round="$(current_round "$dir")"
  [[ -s "$dir/findings-$round.md" ]] \
    || fail "round $round has no findings yet; run 'herdr-review wait $name' first"
  status="$(agent_status "$name")"
  case "$status" in
    idle | done) ;;
    gone) fail "$name is no longer running; start a new review" ;;
    *) fail "$name is $status; run 'herdr-review wait $name' first" ;;
  esac

  next=$((round + 1))
  response="$dir/response-$next.md"
  if [[ -n "$file" ]]; then
    [[ -s "$file" ]] || fail "response file is missing or empty: $file"
    cp "$file" "$response"
  else
    [[ ! -t 0 ]] || usage_error "pass the response with --file or on stdin"
    cat >"$response"
    [[ -s "$response" ]] || { rm -f "$response"; fail "empty response on stdin"; }
  fi

  build_reply_prompt "$(state_read "$dir" repo)" "$(state_read "$dir" base)" "$(state_read "$dir" merge_base)" \
    "$dir/findings-$next.md" "$next" "$response" >"$dir/prompt-$next.md"
  printf '%s\n' "$next" >"$dir/round"
  printf 'herdr-review: sending round %s to %s\n' "$next" "$name" >&2
  prompt_reviewer "$name" "$dir" "$timeout"
  finish "$name" "$dir"
}

cmd_wait() {
  local name="" timeout="$DEFAULT_TIMEOUT" dir
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t | --timeout) [[ $# -ge 2 ]] || usage_error "$1 requires a value"; positive_int "$2"; timeout="$2"; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      -*) usage_error "unknown option: $1" ;;
      *) [[ -z "$name" ]] || usage_error "unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || usage_error "wait requires a reviewer name"
  require_herdr
  dir="$(review_dir "$name")"

  if [[ -f "$dir/prompted-$(current_round "$dir")" ]]; then
    wait_reviewer "$name" "$dir" "$timeout"
  else
    case "$(agent_status "$name")" in
      idle | done) prompt_reviewer "$name" "$dir" "$timeout" ;;
    esac
  fi
  finish "$name" "$dir"
}

cmd_cleanup() {
  local name="${1:-}" dir tab live_tab
  [[ -n "$name" ]] || usage_error "cleanup requires a reviewer name"
  [[ $# -le 1 ]] || usage_error "cleanup accepts one reviewer name"
  dir="$(review_dir "$name")"

  require_herdr
  tab="$(state_read "$dir" tab_id || true)"
  # Tab IDs are per Herdr session, so only close the tab while it still hosts this reviewer.
  live_tab="$("$HERDR_BIN" agent get "$name" 2>/dev/null | json_get result.agent.tab_id 2>/dev/null || true)"
  if [[ -n "$tab" && "$live_tab" == "$tab" ]]; then
    "$HERDR_BIN" tab close "$tab" >/dev/null || fail "could not close tab $tab; nothing removed"
  elif [[ -n "$tab" ]]; then
    printf 'herdr-review: %s is no longer running in tab %s; leaving that tab alone\n' "$name" "$tab" >&2
  fi
  rm -rf -- "$dir"
  printf 'herdr-review: cleaned up %s\n' "$name" >&2
}

main() {
  need git
  need python3
  need "$HERDR_BIN"
  case "${1:-}" in
    reply) shift; cmd_reply "$@" ;;
    wait) shift; cmd_wait "$@" ;;
    cleanup) shift; cmd_cleanup "$@" ;;
    help) usage ;;
    *) cmd_start "$@" ;;
  esac
}

main "$@"

#!/usr/bin/env bash

set -euo pipefail

inside_herdr=${HERDR_ENV:-0}
HERDR_BIN="${HERDR_BIN_PATH:-herdr}"

if [[ "$inside_herdr" != "1" ]] && ! "$HERDR_BIN" status server >/dev/null 2>&1; then
  nohup "$HERDR_BIN" server >/dev/null 2>&1 &

  for _ in {1..50}; do
    "$HERDR_BIN" status server >/dev/null 2>&1 && break
    sleep 0.1
  done

  if ! "$HERDR_BIN" status server >/dev/null 2>&1; then
    echo "herdr-opencode: failed to start the Herdr server" >&2
    exit 1
  fi
fi

cwd=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
source=""
common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [[ -n "$common" ]]; then
  primary=$(dirname "$common")
  if [[ "$primary" != "$cwd" ]] && git -C "$primary" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    source=$(git -C "$primary" rev-parse --show-toplevel 2>/dev/null || true)
  fi
fi

if [[ -n "$source" ]]; then
  response=$("$HERDR_BIN" worktree open --cwd "$source" --path "$cwd" --focus)
else
  response=$("$HERDR_BIN" workspace create --cwd "$cwd" --focus)
fi
pane_id=$(jq -er '.result.root_pane.pane_id' <<< "$response")

deadline=$((SECONDS + 30))
while true; do
  if agent_output=$("$HERDR_BIN" agent start opencode --kind opencode --pane "$pane_id" -- "$@" 2>&1); then
    printf '%s\n' "$agent_output"
    break
  fi

  if [[ "$agent_output" != *'"code":"agent_pane_busy"'* ]] || (( SECONDS >= deadline )); then
    printf '%s\n' "$agent_output" >&2
    exit 1
  fi

  sleep 0.1
done

if [[ "$inside_herdr" != "1" ]]; then
  exec "$HERDR_BIN"
fi

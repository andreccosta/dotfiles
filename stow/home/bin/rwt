#!/usr/bin/env bash
set -euo pipefail

REX_BIN="${REX_BIN_PATH:-rex}"

usage() {
  cat <<'EOF'
Usage: rwt <command> [args]

Commands:
  create <branch> [base]   Create a Worktrunk worktree and open it in a Rex session
  switch [branch-or-path]  Switch/select a Worktrunk worktree and open it in a Rex session
  open [branch-or-path]    Alias for switch
  review <pr|branch|path>  Open a review worktree (--no-hooks) under
                           .worktrees/reviews/; label: <repo>/review/[<pr>/]<branch>
                           A bare number means pr:<n>
  remove [branch-or-path]  Remove a worktree and open the primary checkout
                           Close the invoking session if removing its worktree
                           Review paths use --no-hooks --force-delete

Each open creates a new session, initially labelled <repo>/<branch>
(just <repo> for the primary checkout). Labels are never used for lookup.
If a worktree already exists, create/review will suggest using open instead.
Focusing needs Remote Control turned on in Rex.app (Settings > Rex Server).
Focusing automatically targets the app that owns the invoking terminal pane.

Examples:
  rwt create feature/foo
  rwt create hotfix release/1.2
  rwt switch               # uses Worktrunk's picker
  rwt switch feature/foo
  rwt open feature/foo     # same as switch
  rwt review 123           # review GitHub PR 123 in an isolated worktree
  rwt review feature/foo   # review an existing branch
  rwt remove               # detects review worktrees automatically
EOF
}

fail() {
  printf 'rwt: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

checkout_root() {
  git -C "${1:-$PWD}" rev-parse --path-format=absolute --show-toplevel 2>/dev/null \
    || fail "not inside a git repository"
}

source_root() {
  local root common primary
  root="$(checkout_root "${1:-$PWD}")"

  # If invoked from a linked worktree, resolve the source checkout so session
  # labels group under the same repo name.
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ -n "$common" ]]; then
    primary="$(dirname "$common")"
    # Inside a git dir (submodules, bare layouts) this prints "false" yet exits 0.
    if [[ "$(git -C "$primary" rev-parse --is-inside-work-tree 2>/dev/null)" == true ]]; then
      checkout_root "$primary"
      return
    fi
  fi

  printf '%s\n' "$root"
}

json_field() {
  python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for name in sys.argv[1:]:
    value = data.get(name)
    if value:
        print(value)
        sys.exit(0)
# Worktrunk schema variants used by older/newer versions.
worktree = data.get("worktree")
if isinstance(worktree, dict):
    for name in ("path", "worktree_path", "checkout_path"):
        value = worktree.get(name)
        if value:
            print(value)
            sys.exit(0)
sys.exit(1)
' "$@"
}

worktrunk_path() {
  json_field path worktree_path checkout_path
}

# Labels are only initial display names; agents may rename sessions freely.
session_label() {
  local source="$1" path="$2" prefix="${3:-}" repo name
  repo="$(basename "$source")"
  if [[ "$(cd "$path" && pwd -P)" == "$(cd "$source" && pwd -P)" ]]; then
    printf '%s\n' "$repo"
    return
  fi
  name="$(git -C "$path" branch --show-current 2>/dev/null || true)"
  printf '%s/%s%s\n' "$repo" "$prefix" "${name:-$(basename "$path")}"
}

focus_session() {
  local id="$1" label="$2" error client=""
  local client_args=()
  # A session may be attached to several apps; the invoking pane's owner is
  # more specific than session membership.
  if [[ -n "${REX_SESSION:-}" && -n "${REX_BLOCK:-}" ]]; then
    client="$("$REX_BIN" block call -s "$REX_SESSION" -b "$REX_BLOCK" size 2>/dev/null | json_field owner)" || client=""
  fi
  [[ -z "$client" ]] || client_args=(-C "$client")
  if error="$("$REX_BIN" ${client_args[@]+"${client_args[@]}"} "do" session.select "session_id=$id" 2>&1 >/dev/null)"; then
    return 0
  fi
  printf 'rwt: session %s is ready, but could not be focused\n' "$label" >&2
  [[ -z "$error" ]] || printf '%s\n' "$error" >&2
}

open_in_rex() {
  local source="$1" path="$2" label id
  [[ -n "$path" ]] || fail "empty worktree path"
  label="$(session_label "$source" "$path" "${3:-}")"
  id="$("$REX_BIN" new "$label" --cwd "$path" --json | json_field session_id)" \
    || fail "Rex did not return a session id"
  focus_session "$id" "$label"
}

cmd_create() {
  local branch="${1:-}" base="${2:-}" cwd source out path
  [[ -n "$branch" ]] || fail "create requires a branch name"
  [[ $# -le 2 ]] || fail "create accepts at most: <branch> [base]"

  cwd="$(checkout_root)"
  source="$(source_root "$cwd")"

  if path="$(resolve_worktree_path "$cwd" "$branch")"; then
    existing_worktree "$path"
  fi
  if [[ -n "$base" ]]; then
    out="$(wt -C "$cwd" switch --create "$branch" --base "$base" --no-cd --format=json)"
  else
    out="$(wt -C "$cwd" switch --create "$branch" --no-cd --format=json)"
  fi
  path="$(printf '%s' "$out" | worktrunk_path)" || fail "Worktrunk did not return a worktree path"
  open_in_rex "$source" "$path"
}

open_worktree() {
  local cwd="$1" target="$2" prefix="$3"; shift 3
  local extra=("$@") source out path
  source="$(source_root "$cwd")"

  if [[ -n "$target" ]]; then
    out="$(wt -C "$cwd" switch ${extra[@]+"${extra[@]}"} "$target" --no-cd --format=json)"
  else
    out="$(wt -C "$cwd" switch ${extra[@]+"${extra[@]}"} --no-cd --format=json)"
  fi
  path="$(printf '%s' "$out" | worktrunk_path)" || fail "Worktrunk did not return a worktree path"
  if [[ -n "$prefix" && "$(printf '%s' "$out" | json_field action)" != created ]]; then
    existing_worktree "$path"
  fi
  open_in_rex "$source" "$path" "$prefix"
}

cmd_open() {
  local target="${1:-}" cwd
  [[ $# -le 1 ]] || fail "open accepts at most: [branch-or-path]"
  cwd="$(checkout_root)"
  open_worktree "$cwd" "$target" ""
}

expand_pr_target() {
  local target="$1"
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    printf 'pr:%s\n' "$target"
  else
    printf '%s\n' "$target"
  fi
}

existing_worktree() {
  local path
  printf -v path '%q' "$1"
  fail "worktree already exists; use \`rwt open $path\` instead"
}

is_review_path() {
  case "$1" in
    */.worktrees/reviews/*) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_worktree_path() {
  local root="$1" target="$2"
  if [[ -z "$target" ]]; then
    checkout_root "$root"
    return
  fi
  wt -C "$root" list --format=json | python3 -c '
import json, os, sys
root, target = sys.argv[1:]
# Worktrunk runs from the checkout root, so resolve relative paths the same way, and
# compare real paths so symlinked checkouts still match.
real_target = os.path.realpath(os.path.join(root, target))
data = json.load(sys.stdin)
for item in data.get("items", []):
    wt = item.get("worktree") or {}
    path = wt.get("path")
    if not path:
        continue
    if item.get("branch") == target or os.path.realpath(path) == real_target:
        print(path)
        sys.exit(0)
sys.exit(1)
' "$root" "$target"
}

cmd_review() {
  local target="${1:-}" cwd prefix="review/"
  [[ -n "$target" ]] || fail "review requires a pr-number, branch, or path"
  [[ $# -le 1 ]] || fail "review accepts at most: [pr-number|branch-or-path]"
  cwd="$(checkout_root)"
  target="$(expand_pr_target "$target")"
  if [[ "$target" =~ ^pr:([0-9]+)$ ]]; then
    prefix+="${BASH_REMATCH[1]}/"
  fi
  open_worktree "$cwd" "$target" "$prefix" \
    --no-hooks \
    --config-set "worktree-path='{{ repo_path }}/.worktrees/reviews/{{ branch | sanitize }}'"
}

cmd_remove() {
  local target="${1:-}" cwd source removed_root
  [[ $# -le 1 ]] || fail "remove accepts at most: [branch-or-path]"

  cwd="$(checkout_root)"
  source="$(source_root "$cwd")"
  removed_root="$(resolve_worktree_path "$cwd" "$target" 2>/dev/null || true)"
  if [[ -n "$target" && -z "$removed_root" ]]; then
    printf 'rwt: could not resolve %s; removing it as a regular worktree\n' "$target" >&2
  fi
  local extra=(--foreground)
  if [[ -n "$removed_root" ]] && is_review_path "$removed_root"; then
    extra+=(--no-hooks --force-delete)
  fi

  if [[ -n "$target" ]]; then
    wt -C "$cwd" remove "${extra[@]}" "$target"
  else
    wt -C "$cwd" remove "${extra[@]}"
  fi

  open_in_rex "$source" "$source"
  # Only the invoking session has a known ID; never look up sessions by label.
  if [[ -n "${REX_SESSION:-}" && "$removed_root" == "$cwd" && "$removed_root" != "$source" ]]; then
    "$REX_BIN" kill "$REX_SESSION" >/dev/null || true
  fi
}

main() {
  need git
  need wt
  need python3
  need "$REX_BIN"

  case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    open|switch) shift; cmd_open "$@" ;;
    review) shift; cmd_review "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    -h|--help|help|"") usage ;;
    *) fail "unknown command: $1" ;;
  esac
}

main "$@"

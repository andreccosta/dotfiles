#!/usr/bin/env bash

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done

DOTFILES_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
STOW_DIR="$DOTFILES_DIR/stow"

usage() {
  cat <<'EOF'
Usage: ./dot <command> [package...]

Commands:
  install    Sync the default or specified dotfiles packages into $HOME
  update     Update system packages and mise tools
  macos      Install macOS Brewfile packages and apply macOS defaults
  help       Show this help message
EOF
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

require_command() {
  if ! command_exists "$1"; then
    echo "error: $1 is not installed or not on PATH" >&2
    exit 1
  fi
}

base_packages() {
  cat <<'EOF'
home
agents
ghostty
herdr
kanata
nvim
opencode
pi
worktrunk
zed
EOF
}

os_packages() {
  case "$(uname -s)" in
    Darwin)
      cat <<'EOF'
linearmouse
EOF
      ;;
    Linux)
      cat <<'EOF'
linux-hypr
EOF
      if [ -f /etc/arch-release ]; then
        echo linux-arch
      fi
      ;;
  esac
}

package_args() {
  {
    base_packages
    os_packages
  } | awk 'NF'
}

selected_packages() {
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@"
  else
    package_args
  fi
}

backup_path() {
  local target="$1"
  local backup

  backup="$target.pre-stow-backup-$(date +%Y%m%d%H%M%S)"

  echo "> mv $target $backup"
  mv "$target" "$backup"
}

resolve_link_target() {
  local path="$1"
  local target
  local dir
  local target_dir

  target="$(readlink "$path")"
  case "$target" in
    /*)
      printf '%s\n' "$target"
      ;;
    *)
      dir="$(cd -P "$(dirname "$path")" && pwd)"
      if ! target_dir="$(cd -P "$dir/$(dirname "$target")" 2>/dev/null && pwd)"; then
        return 1
      fi
      printf '%s\n' "$target_dir/$(basename "$target")"
      ;;
  esac
}

has_stow_ancestor() {
  local path="$1"
  local current
  local resolved

  current="$(dirname "$path")"
  while [ "$current" != "$HOME" ] && [ "$current" != "/" ]; do
    if [ -L "$current" ]; then
      if ! resolved="$(resolve_link_target "$current")"; then
        current="$(dirname "$current")"
        continue
      fi
      case "$resolved" in
        "$STOW_DIR"/*)
          return 0
          ;;
      esac
    fi
    current="$(dirname "$current")"
  done

  return 1
}

reconcile_targets() {
  local packages="$1"
  local package
  local src

  is_generated_source() {
    case "$(basename "$1")" in
      node_modules|package-lock.json|pnpm-lock.yaml)
        return 0
        ;;
    esac
    return 1
  }

  reconcile_target() {
    local package="$1"
    local src="$2"
    local rel
    local target
    local resolved
    local child

    # Generated dependency trees are local state, not dotfiles.  In
    # particular, pnpm's symlink graph must not be followed or modified.
    if is_generated_source "$src"; then
      return 0
    fi

    rel="${src#"$STOW_DIR/$package"/}"
    target="$HOME/$rel"

    if [ -L "$target" ]; then
      resolved="$(resolve_link_target "$target")"
      case "$resolved" in
        "$STOW_DIR"/*)
          return 0
          ;;
        "$DOTFILES_DIR"/*)
          echo "> rm $target"
          rm -f "$target"
          return 0
          ;;
      esac
    fi

    if has_stow_ancestor "$target"; then
      return 0
    fi

    if [ -f "$target" ] && [ -f "$src" ] && cmp -s "$src" "$target"; then
      echo "> rm $target"
      rm -f "$target"
      return 0
    fi

    if [ -e "$target" ] && ! { [ -d "$src" ] && [ -d "$target" ]; }; then
      backup_path "$target"
      return 0
    fi

    if [ -d "$src" ] && [ ! -e "$target" ]; then
      return 0
    fi

    # Never recurse through directory symlinks.  Apart from being unsafe,
    # dependency managers commonly create cyclic symlink graphs.
    if [ -d "$src" ] && [ ! -L "$src" ]; then
      while IFS= read -r child; do
        reconcile_target "$package" "$child"
      done < <(find "$src" -mindepth 1 -maxdepth 1)
    fi
  }

  while IFS= read -r package; do
    [ -n "$package" ] || continue

    while IFS= read -r src; do
      reconcile_target "$package" "$src"
    done < <(find "$STOW_DIR/$package" -mindepth 1 -maxdepth 1)
  done <<EOF
$packages
EOF
}

run_stow() {
  local mode="$1"
  shift
  local requested_packages=()
  local stow_options=()
  local packages=()
  local stow_command=()
  local package_list
  local package
  local skip_reconcile=0
  require_command stow

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --)
        shift
        requested_packages+=("$@")
        break
        ;;
      -n|--no|--simulate)
        stow_options+=("$1")
        skip_reconcile=1
        ;;
      -*=*)
        stow_options+=("$1")
        ;;
      -*)
        echo "error: unsupported stow option form: $1" >&2
        echo "use --flag=value for options with values" >&2
        exit 1
        ;;
      *)
        requested_packages+=("$1")
        ;;
    esac
    shift
  done

  cd "$DOTFILES_DIR"

  if [ ${#requested_packages[@]} -gt 0 ]; then
    package_list="$(selected_packages "${requested_packages[@]}")"
  else
    package_list="$(selected_packages)"
  fi

  while IFS= read -r package; do
    [ -n "$package" ] || continue
    if [ ! -d "$STOW_DIR/$package" ]; then
      echo "error: unknown package: $package" >&2
      exit 1
    fi
    packages+=("$package")
  done <<EOF
$package_list
EOF

  RUN_STOW_PACKAGE_LIST="$package_list"
  RUN_STOW_SKIP_RECONCILE="$skip_reconcile"

  if [ "$skip_reconcile" -eq 0 ]; then
    reconcile_targets "$package_list"
  fi

  stow_command=(stow "$mode")
  if [ ${#stow_options[@]} -gt 0 ]; then
    stow_command+=("${stow_options[@]}")
  fi
  stow_command+=(-d "$STOW_DIR" -t "$HOME" "${packages[@]}")

  echo "> ${stow_command[*]}"
  "${stow_command[@]}"
}

package_list_contains() {
  local needle="$1"
  local package

  while IFS= read -r package; do
    [ "$package" = "$needle" ] && return 0
  done <<EOF
$RUN_STOW_PACKAGE_LIST
EOF

  return 1
}

sync_claude_skills() {
  local source_dir="$HOME/.agents/skills"
  local target_dir="$HOME/.claude/skills"
  local skill name target link

  # Never reconcile through a redirected discovery root: it may be shared
  # with another harness, or contain files this installer does not own.
  if [ -L "$target_dir" ] || { [ -e "$target_dir" ] && [ ! -d "$target_dir" ]; }; then
    echo "warning: not syncing Claude skills: $target_dir is not a regular directory" >&2
    return 0
  fi
  if [ ! -d "$source_dir" ]; then
    echo "warning: shared skills directory not found: $source_dir" >&2
    return 0
  fi

  mkdir -p "$target_dir"

  # Only the exact relative links we create are ours to remove. Leave
  # unrelated links, real directories, and Claude's synced/ state alone.
  for target in "$target_dir"/*; do
    [ -L "$target" ] || continue
    name="$(basename "$target")"
    [ "$name" != synced ] || continue
    link="../../.agents/skills/$name"
    [ "$(readlink "$target")" = "$link" ] || continue
    if [ ! -f "$source_dir/$name/SKILL.md" ]; then
      echo "> rm $target"
      rm "$target"
    fi
  done

  for skill in "$source_dir"/*; do
    [ -d "$skill" ] || continue
    [ -f "$skill/SKILL.md" ] || continue
    name="$(basename "$skill")"
    # Claude reserves this name for its downloaded skills.
    if [ "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" = synced ]; then
      echo "warning: skipping reserved Claude skill name: $name" >&2
      continue
    fi
    target="$target_dir/$name"
    link="../../.agents/skills/$name"
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$link" ]; then
      continue
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
      echo "warning: keeping existing Claude skill: $target (shared skill not linked)" >&2
      continue
    fi
    echo "> ln -s $link $target"
    ln -s "$link" "$target"
  done
}

link_herdr_worktrunk_plugin() {
  local plugin_path="$HOME/.config/herdr/plugins/worktrunk"

  if ! command_exists herdr; then
    cat <<EOF

Note: herdr package installed, but the herdr executable is not on PATH.
After installing Herdr, link the Worktrunk plugin with:
  herdr plugin link ~/.config/herdr/plugins/worktrunk --enabled
EOF
    return 0
  fi

  if [ ! -f "$plugin_path/herdr-plugin.toml" ]; then
    echo "warning: Herdr Worktrunk plugin not found at $plugin_path" >&2
    return 0
  fi

  echo
  echo "> herdr plugin link $plugin_path --enabled"
  if ! herdr plugin link "$plugin_path" --enabled; then
    echo "warning: failed to link Herdr Worktrunk plugin" >&2
    return 0
  fi

  echo "> herdr server reload-config"
  if ! herdr server reload-config; then
    echo "warning: Herdr server is not running or config reload failed; the plugin will load next time Herdr starts" >&2
  fi
}

op_ssh_sign_path() {
  local candidate

  case "$(uname -s)" in
    Darwin) candidate="/Applications/1Password.app/Contents/MacOS/op-ssh-sign" ;;
    Linux) candidate="/opt/1Password/op-ssh-sign" ;;
    *) return 1 ;;
  esac

  [ -x "$candidate" ] || return 1
  printf '%s\n' "$candidate"
}

op_agent_socket_path() {
  case "$(uname -s)" in
    Darwin) printf '%s\n' "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ;;
    Linux) printf '%s\n' "$HOME/.1password/agent.sock" ;;
    *) return 1 ;;
  esac
}

op_agent_running() {
  local socket

  socket="$(op_agent_socket_path)" || return 1
  [ -S "$socket" ]
}

is_interactive() {
  [ -t 0 ] && [ -t 1 ]
}

# Display a path with $HOME shortened to ~.
# shellcheck disable=SC2088 # a literal ~ is intended for display
tilde_path() {
  case "$1" in
    "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

signing_note() {
  echo
  echo "Git signing: $*"
}

# Private keys in ~/.ssh that have a matching .pub file.
local_signing_key_candidates() {
  local pub

  for pub in "$HOME"/.ssh/*.pub; do
    [ -f "$pub" ] || continue
    [ -f "${pub%.pub}" ] || continue
    printf '%s\n' "${pub%.pub}"
  done
}

print_manual_signing_steps() {
  cat <<EOF
  To sign with a key stored on this machine (works without an SSH connection):
    git config --file ~/.gitconfig.local user.signingkey /path/to/private_key
  To sign through a forwarded 1Password agent (only while connected):
    git config --file ~/.gitconfig.local dotfiles.signing agent
  See "Git signing & SSH on a new machine" in INSTALL.md.
EOF
}

print_local_key_followup() {
  local key="$1"
  local email

  if ! ssh-keygen -y -P "" -f "$key" >/dev/null 2>&1; then
    echo "  warning: $key is passphrase-protected; unattended signing will fail" >&2
    echo "  unless the key is loaded in an agent." >&2
  fi

  email="$(git config --get user.email 2>/dev/null || echo "<email>")"
  cat <<EOF
  Make sure this public key is added as a *signing* key on GitHub, and to
  stow/home/.config/git/allowed_signers for local verification:
    $email $(cut -d' ' -f1,2 "$key.pub")
EOF
}

prompt_signing_choice() {
  local local_config="$1"
  local candidates=()
  local key
  local choice
  local i
  local new_key

  while IFS= read -r key; do
    candidates+=("$key")
  done < <(local_signing_key_candidates)

  signing_note "1Password is not available on this machine. Choose how to sign commits:"
  i=1
  for key in ${candidates[@]+"${candidates[@]}"}; do
    printf '  %d) %s  (%s)\n' "$i" "$(tilde_path "$key")" "$(ssh-keygen -lf "$key.pub" 2>/dev/null | cut -d' ' -f2-)"
    i=$((i + 1))
  done
  new_key="$HOME/.ssh/$(hostname -s 2>/dev/null || hostname)_git_signing"
  if [ ! -e "$new_key" ]; then
    echo "  g) generate a new dedicated key ($(tilde_path "$new_key"), no passphrase)"
  fi
  echo "  a) use a forwarded agent (only works while connected over SSH)"
  echo "  s) skip for now (ask again next install)"

  while true; do
    printf 'Choice: '
    IFS= read -r choice || choice=s
    case "$choice" in
      s|S|"")
        print_manual_signing_steps
        return 0
        ;;
      a|A)
        echo "> git config --file $local_config dotfiles.signing agent"
        git config --file "$local_config" dotfiles.signing agent
        return 0
        ;;
      g|G)
        if [ -e "$new_key" ]; then
          echo "$new_key already exists; pick it from the list instead." >&2
          continue
        fi
        echo "> ssh-keygen -t ed25519 -N '' -C \"$(hostname) git signing\" -f $new_key"
        ssh-keygen -q -t ed25519 -N '' -C "$(hostname) git signing" -f "$new_key"
        key="$new_key"
        ;;
      *[!0-9]*)
        echo "Invalid choice." >&2
        continue
        ;;
      *)
        if [ "$choice" -lt 1 ] || [ "$choice" -gt "${#candidates[@]}" ]; then
          echo "Invalid choice." >&2
          continue
        fi
        key="${candidates[$((choice - 1))]}"
        ;;
    esac

    echo "> git config --file $local_config user.signingkey $key"
    git config --file "$local_config" user.signingkey "$key"
    print_local_key_followup "$key"
    return 0
  done
}

# Commit signing is configured in the shared .gitconfig with the 1Password
# signing key.  Machine-specific choices live in the untracked
# ~/.gitconfig.local, which is included last and so overrides it:
#   - 1Password available: gpg.ssh.program = op-ssh-sign
#   - otherwise: user.signingkey = a key file on this machine, or
#     dotfiles.signing = agent to sign through a forwarded agent.
configure_git_signing() {
  local local_config="$HOME/.gitconfig.local"
  local program=""
  local local_key=""
  local mode=""
  local op_program

  require_command git

  if [ -f "$local_config" ]; then
    program="$(git config --file "$local_config" --get gpg.ssh.program || true)"
    local_key="$(git config --file "$local_config" --get user.signingkey || true)"
    mode="$(git config --file "$local_config" --get dotfiles.signing || true)"
  fi

  if [ -n "$program" ] && [ ! -x "$program" ]; then
    echo "> git config --file $local_config --unset gpg.ssh.program"
    git config --file "$local_config" --unset gpg.ssh.program
    program=""
  fi

  # An explicit per-machine key always wins.
  if [ -n "$local_key" ]; then
    signing_note "using $local_key (from ~/.gitconfig.local)"
    if [ -n "$program" ]; then
      echo "  warning: gpg.ssh.program is also set to $program; it can only sign" >&2
      echo "  with keys stored in 1Password. Unset one of them." >&2
    fi
    return 0
  fi

  if op_program="$(op_ssh_sign_path)"; then
    if ! op_agent_running; then
      signing_note "1Password is installed but its SSH agent is not running."
      echo "  Enable it in 1Password > Settings > Developer > Use the SSH agent," >&2
      echo "  then rerun ./dot install." >&2
      return 0
    fi
    if [ "$program" != "$op_program" ]; then
      echo "> git config --file $local_config gpg.ssh.program $op_program"
      git config --file "$local_config" gpg.ssh.program "$op_program"
    fi
    signing_note "using 1Password (op-ssh-sign)"
    return 0
  fi

  if [ "$mode" = "agent" ]; then
    signing_note "using the forwarded agent in SSH_AUTH_SOCK (only works while connected)"
    return 0
  fi

  if is_interactive; then
    prompt_signing_choice "$local_config"
  else
    signing_note "not configured on this machine (1Password not available)."
    print_manual_signing_steps
  fi
}

# Report (never edit) SSH settings that the 1Password setup relies on.
check_github_ssh() {
  local socket
  local agent

  command_exists ssh || return 0

  if [ ! -f "$HOME/.ssh/known_hosts" ] || ! ssh-keygen -F github.com >/dev/null 2>&1; then
    cat <<EOF

Note: github.com is not in ~/.ssh/known_hosts. Add it with:
  ssh-keyscan github.com >> ~/.ssh/known_hosts
and compare the fingerprints (ssh-keygen -lf ~/.ssh/known_hosts) against
https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/githubs-ssh-key-fingerprints
EOF
  fi

  op_agent_running || return 0
  socket="$(op_agent_socket_path)"

  agent="$(ssh -G github.com </dev/null 2>/dev/null | awk '/^identityagent / { sub(/^identityagent /, ""); print }')"
  if [ -z "$agent" ] || [ "$agent" = "SSH_AUTH_SOCK" ]; then
    agent="${SSH_AUTH_SOCK:-}"
  fi
  agent="${agent/#\~/$HOME}"

  if [ "$agent" != "$socket" ]; then
    cat <<EOF

Note: ssh does not use the 1Password SSH agent for github.com. Add to ~/.ssh/config:
  Host *
    IdentityAgent "$(tilde_path "$socket")"
EOF
  fi
}

run_install() {
  run_stow -R "$@"

  if [ "${RUN_STOW_SKIP_RECONCILE:-0}" -eq 0 ] && package_list_contains agents; then
    sync_claude_skills
  fi

  if [ "${RUN_STOW_SKIP_RECONCILE:-0}" -eq 0 ] && package_list_contains home; then
    configure_git_signing
    check_github_ssh
    if command_exists bat; then
      echo "> bat cache --build"
      bat cache --build
    fi
  fi

  if [ "${RUN_STOW_SKIP_RECONCILE:-0}" -eq 0 ] && package_list_contains herdr; then
    link_herdr_worktrunk_plugin
  fi

  if [ "${RUN_STOW_SKIP_RECONCILE:-0}" -eq 0 ] && package_list_contains pi; then
    cat <<EOF

Note: the pi package includes a package.json for local extensions.
If dependencies are missing, install them in \$HOME/.pi/agent.
EOF
  fi
}

run_update() {
  if [ "$#" -gt 0 ]; then
    echo "error: update does not accept package arguments" >&2
    exit 1
  fi

  require_command mise

  case "$(uname -s)" in
    Darwin)
      require_command brew
      echo "> brew update && brew upgrade"
      brew update && brew upgrade
      ;;
    Linux)
      if command_exists apt-get; then
        require_command sudo
        echo "> sudo apt-get update && sudo apt-get upgrade -y"
        sudo apt-get update && sudo apt-get upgrade -y
      elif command_exists paru; then
        echo "> paru -Syu"
        paru -Syu
      elif command_exists yay; then
        echo "> yay -Syu"
        yay -Syu
      else
        echo "warning: no supported system package manager found for updates (expected apt-get, paru, or yay on Linux)" >&2
      fi
      ;;
  esac

  echo
  echo "> mise up"
  mise up
}

run_macos() {
  if [ "$#" -gt 0 ]; then
    echo "error: macos does not accept package arguments" >&2
    exit 1
  fi

  if [ "$(uname -s)" != "Darwin" ]; then
    echo "error: macos command is only supported on macOS" >&2
    exit 1
  fi

  require_command brew

  echo "> brew bundle --file mac/Brewfile"
  brew bundle --file "$DOTFILES_DIR/mac/Brewfile"

  echo
  echo "> bash mac/set_defaults.sh"
  bash "$DOTFILES_DIR/mac/set_defaults.sh"
}

main() {
  case "${1:-}" in
    install)
      shift
      run_install "$@"
      ;;
    update)
      shift
      run_update "$@"
      ;;
    macos)
      shift
      run_macos "$@"
      ;;
    -h|--help|help|"")
      if [ "$#" -gt 1 ]; then
        echo "error: help does not accept arguments" >&2
        exit 1
      fi
      usage
      ;;
    *)
      echo "error: unknown command: $1" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
